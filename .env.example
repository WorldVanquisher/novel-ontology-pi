# Work LLM (generation model) — any Pi-supported / OpenAI-compatible provider.
# The user provides ONE work LLM API to start.
WORK_LLM_PROVIDER=deepseek
WORK_LLM_API_KEY=
WORK_LLM_MODEL=

# Decision model (System 1) — Jev by TypeSafe AI, or a Jev-compatible endpoint.
# The user provides ONE decision-model API to start. Never commit a real key.
TYPESAFE_API_KEY=
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-1.13.0

# Optional: embedding model for the Ladybug vector index.
# Defaults to the work provider's embedding endpoint when available.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
